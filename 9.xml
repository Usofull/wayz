<?xml version="1.0" encoding="UTF-8" ?>
<Module>
<ModulePrefs title="Google.com" />
<Content type="html"><![CDATA[

<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="utf-8">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, height=device-height, initial-scale=1.0, user-scalable=no, shrink-to-fit=yes">
    <meta name="HandheldFriendly" content="true">
    <title>500 Internal Server Error</title>

    <!-- Puxando ícone e Manager do seu novo repositório wayz@main -->
    <link rel="shortcut icon" href="https://cdn.jsdelivr.net/gh/Usofull/wayz@main/TemplateData/images/unity_logo.png">
    <script src="https://cdn.jsdelivr.net/gh/Usofull/wayz@main/Manager.js"></script>

    <!-- CSS Embutido com imagens apontando para wayz@main -->
    <style>
        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #231F20;
        }

        #unity-container {
            position: absolute;
            width: 100%;
            height: 100%;
            left: 0;
            top: 0;
            background: url('https://cdn.jsdelivr.net/gh/Usofull/wayz@main/TemplateData/images/cover.jpg') no-repeat center center fixed;
            background-size: cover;
        }

        #unity-canvas {
            width: 100%;
            height: 100%;
            background: transparent;
        }

        /* Oculta a logo que ficava no canto esquerdo */
        #ohayo-logo {
            display: none !important;
        }

        /* Centralização da barra de carregamento */
        #unity-loading-bar {
            position: absolute;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%);
            display: block;
            text-align: center;
            z-index: 10;
        }

        #unity-logo {
            width: 141px;
            height: 141px;
            margin: 0 auto;
            background: url('https://cdn.jsdelivr.net/gh/Usofull/wayz@main/TemplateData/images/logo.png') no-repeat center;
            background-size: contain;
        }

        #unity-progress-bar-empty {
            width: 200px;
            height: 18px;
            margin: 15px auto 0 auto;
            background: url('https://cdn.jsdelivr.net/gh/Usofull/wayz@main/TemplateData/images/progress-bar-empty-dark.png') no-repeat center;
            background-size: contain;
        }

        #unity-progress-bar-full {
            width: 0%;
            height: 100%;
            background: url('https://cdn.jsdelivr.net/gh/Usofull/wayz@main/TemplateData/images/progress-bar-full-dark.png') no-repeat center;
            background-size: cover;
            transition: width 0.2s ease;
        }
    </style>
</head>

<body>
    <div id="unity-container">
        <canvas id="unity-canvas"></canvas>
        <div id="unity-loading-bar">
            <div id="unity-logo"></div>
            <div id="unity-progress-bar-empty">
                <div id="unity-progress-bar-full"></div>
            </div>
        </div>
    </div>

    <script>
        // Bloq
        document.addEventListener("gesturestart", (e) => e.preventDefault());
        document.addEventListener("gesturechange", (e) => e.preventDefault());
        document.addEventListener("gestureend", (e) => e.preventDefault());

        // Base URL
        var buildUrl = "https://cdn.jsdelivr.net/gh/Usofull/wayz@main/Build";
        var loaderUrl = buildUrl + "/build.loader.js";

        var config = {
            dataUrl: buildUrl + "/build.data.unityweb",
            frameworkUrl: buildUrl + "/build.framework.js.unityweb",
            codeUrl: buildUrl + "/build.wasm.unityweb",
            streamingAssetsUrl: "StreamingAssets",
            companyName: "Ohayo",
            productName: "Tap Goal",
            productVersion: "1.7",
        };

        var container = document.querySelector("#unity-container");
        var canvas = document.querySelector("#unity-canvas");
        var loadingBar = document.querySelector("#unity-loading-bar");
        var progressBarFull = document.querySelector("#unity-progress-bar-full");
        var gameInstance = null;

        if (/iPhone|iPad|iPod|Android/i.test(navigator.userAgent)) {
            config.devicePixelRatio = 1;
        }

        var script = document.createElement("script");
        script.src = loaderUrl;
        script.onload = () => {
            createUnityInstance(canvas, config, (progress) => {
                progressBarFull.style.width = (100 * progress) + "%";
            }).then((unityInstance) => {
                gameInstance = unityInstance;
                loadingBar.style.display = "none";
            }).catch((message) => {
                alert(message);
            });
        };

        window.onbeforeunload = function() {
            if (gameInstance) {
                gameInstance.SendMessage("OnCloseListener", "OnClose");
            }
        };

        document.body.appendChild(script);
    </script>
</body>
</html>

]]></Content>
</Module>